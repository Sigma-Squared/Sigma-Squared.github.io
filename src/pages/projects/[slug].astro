---
import Base from '../../layouts/Base.astro';
import BlurImage from '../../components/BlurImage.astro';
import { projects } from '../../data/projects';
import { toPlainText } from '../../lib/text';
import type { Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const plain = toPlainText(project.description[0]);
// A drop cap on a paragraph that opens with a link splits the link's first
// letter away from the underlined remainder, so only use one on plain text.
const dropCap = !/^\s*</.test(project.description[0]);
---

<Base
  title={`${project.title} · Chamu Rajasekera`}
  description={plain}
  path={`/projects/${project.slug}`}
>
  <article class="section">
    <div class="wrap">
      <a class="article__kicker label" href="/#projects">&larr; Projects</a>
      <h1 class="article__headline">{project.title}</h1>

      {
        project.animation && (
          <figure class="plate plate--lead">
            <img
              src={project.animation.src}
              alt={project.animation.alt}
              width={project.animation.width}
              height={project.animation.height}
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }

      <div class:list={['article__body', dropCap && 'article__body--dropcap']}>
        {project.description.map((para) => (
          <p set:html={para} />
        ))}
      </div>

      {
        project.links && project.links.length > 0 && (
          <ul class="inline-list">
            {project.links.map((link) => (
              <li>
                <a class="rule-link" href={link.href}>
                  {link.label} &rarr;
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        project.playHref && (
          <div class="notice">
            <p>
              The game runs in the browser. It is a large download and needs a desktop
              browser with a keyboard and mouse.
            </p>
            <p>
              <a class="rule-link" href={project.playHref}>
                Play {project.title} &rarr;
              </a>
            </p>
          </div>
        )
      }

      {
        project.gallery.map((image) => (
          <figure class="plate">
            <BlurImage
              path={image.path}
              alt={image.alt}
              sizes="(min-width: 46rem) 41rem, 92vw"
              widths={[640, 960, 1440]}
            />
            <figcaption>{image.alt}</figcaption>
          </figure>
        ))
      }

      <nav class="article__nav" aria-label="Other projects">
        {prev ? <a href={`/projects/${prev.slug}`}>&larr; {prev.title}</a> : <span></span>}
        {next ? <a href={`/projects/${next.slug}`}>{next.title} &rarr;</a> : <span></span>}
      </nav>
    </div>
  </article>
</Base>
