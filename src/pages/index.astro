---
import Base from '../layouts/Base.astro';
import BlurImage from '../components/BlurImage.astro';
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';
import { projects } from '../data/projects';
import { firstSentence } from '../lib/text';

const profile = getImage('profile.png');
---

<Base
  title="Chamu Rajasekera"
  description="Chamu Rajasekera, senior software engineer at Microsoft, working on Power Apps and the Power Fx language."
  path="/"
>
  <section class="lede">
    <div class="wrap">
      <h1 class="lede__headline">Hello There!</h1>
      <p class="lede__text">
        Nice to meet you. I'm Chamu. Senior software engineer at Microsoft and
        passionate programmer. Get to know me.
      </p>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">About Me</h2>
      <div class="about__layout">
        <Image
          class="portrait"
          src={profile}
          alt="Chamu Rajasekera"
          width={256}
          height={256}
          loading="lazy"
        />
        <div class="prose">
        <p>
          I first started programming around the age of 13, and I'm still addicted to
          learning. My expertise is in languages, embedded devices, and
          optimization. I often spend my free time attempting to learn things I find
          interesting. I love creating things; I find programming, game design, and web
          development to be my best outlets.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* Work history lives in src/components/Work.astro. Import it and render
      <Work /> here to show it again. */}

  <section id="projects" class="section">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">Projects</h2>
      <p class="section__note">
        Hardware, games, server plugins, and other things I build outside of work.
      </p>
      <ul class="stories">
        {
          projects.map((project, i) => (
            <li class="story">
              {project.cover ? (
                <BlurImage
                  class="story__media"
                  path={project.cover.path}
                  alt={project.cover.alt}
                  ratio="16 / 10"
                  sizes="(min-width: 34rem) 9rem, 92vw"
                  widths={[288, 432, 640]}
                  eager={i < 2}
                />
              ) : (
                <div class="story__media story__media--blank" aria-hidden="true">
                  {project.placeholder}
                </div>
              )}
              <h3 class="story__headline">
                <a href={`/projects/${project.slug}`}>{project.title}</a>
              </h3>
              <p class="story__standfirst">{firstSentence(project.description[0])}</p>
              <p class="story__more">
                <a href={`/projects/${project.slug}`}>Read more &rarr;</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">Find Me</h2>
      <div class="prose">
        <p>
          Feel free to contact me through any of the social media below, or through
          email.
        </p>
      </div>
      <ul class="inline-list">
        <li><a class="rule-link" href="mailto:chamu.rajasekera@gmail.com">Email</a></li>
        <li><a class="rule-link" href="https://github.com/Sigma-Squared">Github</a></li>
        <li>
          <a class="rule-link" href="https://github.com/Chamu-Rajasekera">
            Github (MSFT)
          </a>
        </li>
        <li>
          <a class="rule-link" href="https://ca.linkedin.com/in/chamurajasekera">
            LinkedIn
          </a>
        </li>
        <li>
          <a class="rule-link" href="https://www.hackerrank.com/SigmaSquared">
            HackerRank
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>
