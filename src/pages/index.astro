---
import Base from '../layouts/Base.astro';
import BlurImage from '../components/BlurImage.astro';
import { Image } from 'astro:assets';
import { getImage } from '../lib/images';
import { projects } from '../data/projects';
import { roles, education } from '../data/experience';
import { firstSentence } from '../lib/text';

const profile = getImage('profile.png');
---

<Base
  title="Chamu Rajasekera"
  description="Chamu Rajasekera — senior software engineer at Microsoft, working on Power Apps and the Power Fx language."
  path="/"
>
  <section class="lede">
    <div class="wrap">
      <h1 class="lede__headline">Hello There!</h1>
      <p class="lede__text">
        Nice to meet you. I'm Chamu. Senior software engineer at Microsoft and
        passionate programmer. Get to know me.
      </p>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">About Me</h2>
      <Image
        class="portrait"
        src={profile}
        alt="Chamu Rajasekera"
        width={256}
        height={256}
        loading="lazy"
      />
      <div class="prose">
        <p>
          I'm a senior software engineer at Microsoft in Redmond, where I work on Power
          Apps and its integrated <a href="https://github.com/microsoft/Power-Fx">Power
          Fx</a> language. I've been with the team since 2019, and on Power Fx since
          2021.
        </p>
        <p>
          I graduated from McMaster University in 2019 with a degree in Software
          Engineering &amp; Game Design, on the Dean's Honour List. Before Microsoft I
          interned at Intel's Programmable Solutions Group in San Jose, first on physical
          synthesis optimization and verification, then on the infrastructure and build
          team.
        </p>
        <p>
          I first started programming around the age of 13, and I'm still addicted to
          learning — I often spend my free time attempting to learn things I find
          interesting. I love creating things; I find programming, game design, and web
          development the best outlets for my passion.
        </p>
      </div>
    </div>
  </section>

  <section id="work" class="section">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">Work</h2>
      <ol class="roles">
        {
          roles.map((role) => (
            <li class="role">
              <div class="role__when">
                <span class="role__period">{role.period}</span>
                <span class="role__where">{role.location}</span>
              </div>
              <div class="role__what">
                <h3 class="role__title">
                  {role.title}, <span class="role__org">{role.org}</span>
                </h3>
                {role.note && (
                  <p class="role__note">
                    {role.note}
                    {role.href && (
                      <>
                        {' '}
                        <a href={role.href}>Power&nbsp;Fx on GitHub</a>
                      </>
                    )}
                  </p>
                )}
              </div>
            </li>
          ))
        }
        <li class="role">
          <div class="role__when">
            <span class="role__period">{education.period}</span>
            <span class="role__where">Hamilton, Ontario</span>
            <span class="role__kind">Education</span>
          </div>
          <div class="role__what">
            <h3 class="role__title">
              {education.programme}, <span class="role__org">{education.school}</span>
            </h3>
            <p class="role__note">{education.note}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">Projects</h2>
      <p class="section__note">
        Hardware, games, server plugins, and other things I build outside of work.
      </p>
      <ul class="stories">
        {
          projects.map((project, i) => (
            <li class="story">
              {project.cover ? (
                <BlurImage
                  class="story__media"
                  path={project.cover.path}
                  alt={project.cover.alt}
                  ratio="16 / 10"
                  sizes="(min-width: 34rem) 9rem, 92vw"
                  widths={[288, 432, 640]}
                  eager={i < 2}
                />
              ) : (
                <div class="story__media story__media--blank" aria-hidden="true">
                  {project.placeholder}
                </div>
              )}
              <h3 class="story__headline">
                <a href={`/projects/${project.slug}`}>{project.title}</a>
              </h3>
              <p class="story__standfirst">{firstSentence(project.description[0])}</p>
              <p class="story__more">
                <a href={`/projects/${project.slug}`}>Read more &rarr;</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="wrap wrap--wide">
      <h2 class="section__head label">Find Me</h2>
      <div class="prose">
        <p>
          Feel free to contact me through any of the social media below, or through
          email.
        </p>
      </div>
      <ul class="inline-list">
        <li><a class="rule-link" href="mailto:chamu.rajasekera@gmail.com">Email</a></li>
        <li><a class="rule-link" href="https://github.com/Sigma-Squared">Github</a></li>
        <li>
          <a class="rule-link" href="https://www.hackerrank.com/SigmaSquared">
            HackerRank
          </a>
        </li>
        <li>
          <a class="rule-link" href="https://ca.linkedin.com/in/chamurajasekera">
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>
